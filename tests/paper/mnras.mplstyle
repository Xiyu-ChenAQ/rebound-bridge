font.family: serif
font.serif: STIXGeneral, DejaVu Serif
mathtext.fontset: stix
font.size: 8.0
axes.titlesize: 8.5
axes.labelsize: 8.0
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: both
axes.grid.which: major
grid.color: d0d0d0
grid.linewidth: 0.45
grid.alpha: 0.65
xtick.labelsize: 7.5
ytick.labelsize: 7.5
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.minor.size: 1.8
ytick.minor.size: 1.8
legend.fontsize: 7.3
legend.frameon: False
lines.linewidth: 1.35
lines.markersize: 4.2
savefig.dpi: 320
savefig.bbox: tight
savefig.pad_inches: 0.03
pdf.fonttype: 42
ps.fonttype: 42
